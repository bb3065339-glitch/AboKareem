rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // المدير الرئيسي: يُتحقق منه من توكن Firebase على الخادم (البريد لازم يكون مُفعّل)
    function mainAdmin() {
      return signedIn()
        && request.auth.token.email == 'bb3065339@gmail.com'
        && request.auth.token.email_verified == true;
    }
    // مدير = المدير الرئيسي أو مستخدم أضافه المدير الرئيسي في مجموعة admins
    function isAdmin() {
      return mainAdmin()
        || (signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    function notDeleted() {
      return !exists(/databases/$(database)/documents/deletedUsers/$(request.auth.uid));
    }
    function notBlocked() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('blocked', false) == false;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid && notDeleted()
        && request.resource.data.keys().hasOnly(['name','phone','address','email','createdAt','updatedAt','blocked'])
        && request.resource.data.blocked == false
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid && notDeleted()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','address','updatedAt'])
            && request.resource.data.name is string && request.resource.data.name.size() <= 60);
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /admins/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if mainAdmin();
    }

    match /deletedUsers/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // محتوى الموقع: قراءة للجميع، كتابة للمدير فقط
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cats/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /items/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.data.get('img', '').size() < 450000;
      allow delete: if isAdmin();
    }

    match /orders/{id} {
      allow create: if request.resource.data.keys().hasOnly(['no','uid','name','phone','type','address','items','subtotal','fee','total','notes','status','createdAt'])
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && (request.resource.data.uid == null
            || (signedIn() && request.resource.data.uid == request.auth.uid && notBlocked()))
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 60
        && request.resource.data.total is number && request.resource.data.total >= 0;
      allow get: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if signedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isAdmin();
    }
  }
}
