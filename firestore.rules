rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // التحقق من تسجيل الدخول
    function signedIn() {
      return request.auth != null;
    }

    // المدير الرئيسي
    function mainAdmin() {
      return signedIn()
        && request.auth.token.email == 'bb3065339@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // المديرون الإضافيون
    function isAdmin() {
      return mainAdmin()
        || (
          signedIn()
          && exists(
            /databases/$(database)/documents/admins/$(request.auth.uid)
          )
        );
    }

    // صاحب الحساب
    function isOwner(uid) {
      return signedIn()
        && request.auth.uid == uid;
    }

    // التحقق من بيانات إنشاء الحساب
    function validUserCreate(uid) {
      return isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'name',
          'phone',
          'address',
          'email',
          'createdAt',
          'updatedAt',
          'blocked'
        ])
        && request.resource.data.get('blocked', false) == false
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string;
    }

    // حسابات المستخدمين
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if validUserCreate(uid);

      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'name',
              'phone',
              'address',
              'photo',
              'updatedAt',
              'lastLoginAt'
            ])
        );

      allow delete: if isAdmin();
    }

    // المديرون
    match /admins/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow create, update, delete: if mainAdmin();
    }

    // الحسابات المحذوفة
    match /deletedUsers/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // الطلبات
    match /orders/{orderId} {
      allow create: if
        request.resource.data.uid == null
        || (
          signedIn()
          && request.resource.data.uid == request.auth.uid
        );

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    // إعدادات الموقع
    match /site/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // أقسام المنيو
    match /cats/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // أصناف المنيو
    match /items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // محافظ العملاء
    match /wallets/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // الكتابة من Cloud Functions فقط
      allow create, update, delete: if false;
    }

    // سجل معاملات النقاط
    match /walletTx/{txId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
        );

      // ممنوع التعديل المباشر من المتصفح
      allow create, update, delete: if false;
    }

    // سجل عمليات الإدارة
    match /adminLogs/{logId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if false;
    }

    // منع الوصول لأي مستند غير محدد
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
