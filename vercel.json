{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://ak12-bd123.firebaseapp.com/__/auth/:path*" },
    { "source": "/__/firebase/:path*", "destination": "https://ak12-bd123.firebaseapp.com/__/firebase/:path*" }
  ],
  "headers": [
    { "source": "/js/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
    { "source": "/css/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
